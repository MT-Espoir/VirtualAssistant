# Sao chép file này thành .env và chỉnh giá trị nếu muốn override cấu hình mặc định.
# .env chỉ được tự nạp khi đã cài python-dotenv (pip install python-dotenv);
# nếu không, bạn vẫn có thể set trực tiếp các biến môi trường này ở shell.

# --- Audio ---
# SAMPLE_RATE=16000
# CHUNK_SIZE=1024
# CHANNELS=1
# SPEECH_THRESHOLD_RATIO=1.2

# --- STT (nhận dạng giọng nói) ---
# STT_LANGUAGE=vi-VN
# STT_ENGINE=google

# --- TTS (tổng hợp giọng nói) ---
# TTS_ENGINE=gtts               # gtts (Google, online) | pyttsx3 (offline, giọng hệ điều hành)
# TTS_LANGUAGE=vi
# TTS_ROBOT=false               # true = giọng robot (ring modulation trên gTTS, vẫn đúng tiếng Việt)
# TTS_ROBOT_CARRIER=80          # Hz; giảm (vd 50) để robot hơn, tăng để nhẹ hơn

# --- Agent LLM ---
# LLM_PROVIDER=ollama            # ollama (local, mặc định) | claude (API)

# --- Bộ nhớ hội thoại ---
# MAX_HISTORY_TURNS=10           # số lượt hội thoại agent nhớ
# MEMORY_PATH=                   # đường dẫn file lưu bộ nhớ; rỗng = chỉ nhớ trong phiên

# Nếu dùng LLM local (Ollama) — cần cài Ollama và `ollama pull <model>`:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b-instruct   # model phải hỗ trợ tool-calling (qwen2.5, llama3.1...)

# Nếu dùng Claude API (LLM_PROVIDER=claude):
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-8
# LLM_MAX_TOKENS=1024

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FILE=
