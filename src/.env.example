# Sao chép file này thành .env và chỉnh giá trị nếu muốn override cấu hình mặc định.
# .env chỉ được tự nạp khi đã cài python-dotenv (pip install python-dotenv);
# nếu không, bạn vẫn có thể set trực tiếp các biến môi trường này ở shell.

# --- Audio ---
# SAMPLE_RATE=16000
# CHUNK_SIZE=1024
# CHANNELS=1
# SPEECH_THRESHOLD_RATIO=1.2

# --- STT (nhận dạng giọng nói) ---
# STT_LANGUAGE=vi-VN
# STT_ENGINE=google

# --- TTS (tổng hợp giọng nói) ---
# TTS_ENGINE=gtts
# TTS_LANGUAGE=vi

# --- Agent LLM (Claude tool-calling) ---
# ANTHROPIC_API_KEY=sk-ant-...   # bắt buộc để chạy agent (agent_cli.py)
# LLM_MODEL=claude-opus-4-8
# LLM_MAX_TOKENS=1024

# --- LLM (Ollama - hội thoại cũ / offline) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=phi3:3.8b

# --- Logging ---
# LOG_LEVEL=INFO
# LOG_FILE=
